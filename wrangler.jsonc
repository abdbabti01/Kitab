{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitab2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Verify the model and its price in the Workers AI catalog before changing it.
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "DAILY_GENERATIONS_PER_IP": "20",
    "DAILY_GENERATIONS_PER_SESSION": "20",
    "DAILY_GENERATIONS_GLOBAL": "500",
    "DAILY_TUTOR_PER_IP": "120",
    "DAILY_TUTOR_PER_SESSION": "80",
    "DAILY_TUTOR_GLOBAL": "5000",
    "DAILY_TOKEN_BUDGET": "2000000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitab-db",
      "database_id": "c22c58b7-64af-4251-ab7f-5b18e8886247",
      "migrations_dir": "migrations"
    }
  ]
}
