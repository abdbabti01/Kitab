{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitab2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // The model must accept response_format json_schema and have a rate in worker/quota.ts MODEL_NEURONS.
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "DAILY_GENERATIONS_PER_IP": "20",
    "DAILY_GENERATIONS_PER_SESSION": "20",
    "DAILY_GENERATIONS_GLOBAL": "500",
    "DAILY_TUTOR_PER_IP": "120",
    "DAILY_TUTOR_PER_SESSION": "80",
    "DAILY_TUTOR_GLOBAL": "5000",
    // Real AI is off ("0") until the account is confirmed to be on the Workers Free plan, where Cloudflare itself
    // stops Workers AI at 10,000 Neurons a day. On Free, set "5000": half the allowance, leaving margin.
    "DAILY_NEURON_BUDGET": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitab-db",
      "database_id": "c22c58b7-64af-4251-ab7f-5b18e8886247",
      "migrations_dir": "migrations"
    }
  ]
}
